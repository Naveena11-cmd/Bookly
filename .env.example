# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Application
APP_URL=http://localhost:5173
# Billing: "simulate" (no Stripe needed) or "stripe"
BILLING_MODE=simulate
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Notifications (empty = mock adapter that logs to console)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Protects /api/cron/reminders (Vercel sends it as a Bearer token)
CRON_SECRET=
